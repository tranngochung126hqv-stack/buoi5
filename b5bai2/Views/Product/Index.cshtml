@model List<WeekendApp.Models.Product>

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Danh sách sản phẩm</title>

    <style>
            table {
                border-collapse: collapse;
                width: 600px;
            }

            th, td {
                border: 1px solid black;
                padding: 10px;
            }

            th {
                background-color: lightgray;
            }
    </style>
</head>

<body>

    <h1>Danh sách sản phẩm</h1>

    <table>
        <thead>
            <tr>
                <th>Id</th>
                <th>Tên sản phẩm</th>
                <th>Giá</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <td>@product.Id</td>
                    <td>@product.Name</td>
                    <td>@product.Price.ToString("N0") VNĐ</td>
                </tr>
            }
        </tbody>
    </table>

</body>
</html>